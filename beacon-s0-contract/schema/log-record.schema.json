{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beacon.internal/schema/log-record.schema.json",
  "title": "Beacon Log Record",
  "description": "Canonical JSON representation of an OTel-aligned Beacon log record. See spec/01-telemetry-record-spec.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "timestamp",
    "severity_number",
    "severity_text",
    "body",
    "resource"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "$comment": "RFC3339 with optional fractional seconds. 'format' is annotation-only in draft 2020-12, so this pattern is what actually enforces the shape across validators."
    },
    "observed_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "severity_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "severity_text": {
      "type": "string",
      "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
    },
    "body": {
      "type": "string"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$",
      "$comment": "32 lowercase hex chars; the negative lookahead rejects the all-zero (invalid) trace id per spec/01 §4."
    },
    "span_id": {
      "type": "string",
      "pattern": "^(?!0{16}$)[0-9a-f]{16}$",
      "$comment": "16 lowercase hex chars; the negative lookahead rejects the all-zero (invalid) span id per spec/01 §4."
    },
    "trace_flags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "resource": {
      "type": "object",
      "additionalProperties": true,
      "required": ["service.name", "telemetry.sdk.language"],
      "properties": {
        "service.name": { "type": "string", "minLength": 1 },
        "service.version": { "type": "string" },
        "deployment.environment": { "type": "string" },
        "host.name": { "type": "string" },
        "telemetry.sdk.language": { "type": "string", "minLength": 1 },
        "telemetry.sdk.name": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
